rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lecture publique des actualités et de l'agenda ; écriture réservée aux comptes connectés (administration)
    match /news/{id} { allow read: if true; allow write: if request.auth != null; }
    match /events/{id} { allow read: if true; allow write: if request.auth != null; }
    // Les visiteurs peuvent envoyer un message ou une pré-inscription ; seule l'administration peut les lire, modifier, supprimer
    match /messages/{id} { allow create: if true; allow read, update, delete: if request.auth != null; }
    match /inscriptions/{id} { allow create: if true; allow read, update, delete: if request.auth != null; }
  }
}
